#!/bin/zsh

set -e

# VERSION awareness
version="0.1.3"

# Hardcode PATH to ensure MacOS-provided executables are exclusively used
# Reminder, BSD tools are quite different from GNU tooling
export PATH="/bin:/usr/bin:/sbin:/usr/sbin"

# Only support MacOS
if ! uname | grep -qE '^Darwin' &>/dev/null
then
    echo "Did not detect MacOS. Exiting."
    exit 1
else
    # Install command-line tools if not installed
    pkgutil --pkg-info com.apple.pkg.CLTools_Executables &>/dev/null || xcode-select --install
fi

# Global variables, can be overridden in cart.config
downloads="/tmp/cart/downloads"
mountpoints="/tmp/cart/mountpoints"
apps_folder="${HOME}/Applications"
cart_dir="${HOME}/Library/Application Support/cart"
jq_force_install="false"
jq_version="1.8.1"
jq_arm64_hash="a9fe3ea2f86dfc72f6728417521ec9067b343277152b114f4e98d8cb0e263603"
jq_x86_64_hash="e80dbe0d2a2597e3c11c404f03337b981d74b4a8504b70586c354b7697a7c27f"
# grab hashes with:
# jq_version="1.8.1" curl -Ls https://github.com/jqlang/jq/releases/download/jq-$jq_version/jq-macos-arm64 -o /tmp/jq-arm64 && shasum -a 256 /tmp/jq-arm64
# jq_version="1.8.1" curl -Ls https://github.com/jqlang/jq/releases/download/jq-$jq_version/jq-macos-amd64 -o /tmp/jq-amd64 && shasum -a 256 /tmp/jq-amd64

# Other global variables, not managed with config
archive_url=""
file_type=""

# Prep needed for actual package management (add, del)
prep() {
    # Prep phase
    [[ -n "${cart_debug}" ]] || cart_debug="false"

    # Usage if something besides URL is provided
    config_file=""
    source_config() {
        file="$1"
        if [[ -z "${config_file}" ]]
        then
            if [[ -e "${file}" ]]
            then
                [[ "${cart_debug}" == "true" ]] && echo "Config file discovered: ${file}"
                source "${file}"
            fi
        fi
    }

    if [[ -n ${CART_CONFIG} ]]
    then
        source_config "${CART_CONFIG}"
    else
        source_config "./cart.config" \
            || source_config "${HOME}/Library/Application Support/cart/cart.config" \
            || source_config "${HOME}/.config/cart/cart.config"
    fi

    # Use /Applications if root
    if [[ -z "${apps_folder}" ]]
    then
        apps_folder="${HOME}/Applications"
        if [[ $(id -u) == 0 ]]
        then
            [[ "${cart_debug}" == "true" ]] && echo "Running as root, apps will be installed to /Applications"
            apps_folder="/Applications"
        else
           [[ "${cart_debug}" == "true" ]] && echo "Running unprivileged, apps will be installed to ${HOME}/Applications"
           apps_folder="${HOME}/Applications"
        fi
    fi

    # Create directories
    mkdir -p "${mountpoints}" "${downloads}" "${apps_folder}"

    # For older MacOS versions, install jq
    export PATH="${cart_dir}/bin:${PATH}"
    if ! command -v jq &>/dev/null || [[ "${jq_force_install}" == "true" ]]
    then
        [[ "${cart_debug}" == "true" ]] && echo "Installing jq"
        mkdir -p "${cart_dir}/bin"
        [[ "$(arch)" == "arm64" ]] && jq_arch="arm64" && jq_hash="${jq_arm64_hash}"
        [[ -z "${jq_arch}" ]] && jq_arch="amd64" && jq_hash="${jq_x86_64_hash}"
        jq_url="https://github.com/jqlang/jq/releases/download/jq-${jq_version}/jq-macos-${jq_arch}"
        [[ "${cart_debug}" == "true" ]] && echo "Downloading: ${jq_url}"
        curl -Ls "${jq_url}" -o "${cart_dir}/bin/jq" && chmod +x "${cart_dir}/bin/jq"
        [[ "${jq_hash}" != $(shasum -a 256 "${cart_dir}/bin/jq" | awk '{print $1}') ]] && echo "jq hash mismatch. Exiting." && exit 1
    fi
    command -v jq &>/dev/null || { echo "jq not found. Exiting."; exit 1; }
}

filename=""
local_file="false"
download_file() {
    [[ -e "${archive_url}" ]] && local_file="true"
    if [[ "${local_file}" == "true" ]]
    then
        [[ "${cart_debug}" == "true" ]] && echo "Using local file ${archive_url}"
        filename="${archive_url}"
    else
        # Download filename
        [[ "${cart_debug}" == "true" ]] && echo "Downloading ${archive_url}..."
        rm -rf "${downloads}" && mkdir -p "${downloads}" # clear downloads folder if incomplete downloads exist (i.e. if `cart add` is interrupted)
        filename="$(curl --progress-bar --output-dir "${downloads}" -OJsL "${archive_url}" -w "%{filename_effective}")"
        [[ "${cart_debug}" == "true" ]] && echo "Output file: ${filename}"
    fi
}

filehash=""
check_hash() {
    filehash="$(shasum -a 256 ${filename} | awk '{print $1}')"
    # If hash provided, ensure it matches
    if [[ -n "${hash}" ]]
    then
        if [[ "${hash}" != "${filehash}" ]]
        then
            printf "Incorrect file hash provided.\n${filename} hash: ${filehash}\nExiting." && exit 3
        else
            [[ "${cart_debug}" == "true" ]] && printf "File hash looks good.\n"
        fi
    fi
}

app_name=""
app_dest=""
install_app() {
    app_path="$1"
    # Install .app if found
    if find "${app_path}" -maxdepth 1 -name "*.app" &>/dev/null
    then
        appfilepath="$(find "${app_path}" -maxdepth 1 -name "*.app")"
        appfile="$(basename ${appfilepath})"
        [[ "${cart_debug}" == "true" ]] && echo "Copying: ${appfilepath} => ${apps_folder}/${appfile}"
        rsync -a --delete "${appfilepath}" "${apps_folder}"
        app_name="${appfile%.*}"
        app_dest="${apps_folder}/${appfile}"
        [[ "${cart_debug}" == "true" ]] && echo "App name: ${app_name}"
    else
        [[ "${cart_debug}" == "true" ]] && echo "Unable to find .app in ${app_path}."
        false
    fi
}

install_dmg() {
    # Ensure that file is a valid dmg file
    [[ "${cart_debug}" == "true" ]] && echo "Ensuring ${filename} integrity"
    if ! hdiutil verify "${filename}" &> /dev/null
    then
        echo "File ${filename} failed dmg integrity check. Cleaning up and Exiting."
        rm -f "${filename}"
        exit 2
    fi

    # Mount dmg if it doesn't exist
    basename="$(basename "${filename}")"
    [[ "${cart_debug}" == "true" ]] && echo "Mounting ${mountpoints}/${basename}."
    rm -rf "${mountpoints}/${basename}"
    mkdir -p "${mountpoints}"
    [[ -e "${mountpoints}/${basename}" ]] || hdiutil attach -mountpoint "${mountpoints}/${basename}" "${filename}" > /dev/null

    install_app "${mountpoints}/${basename}"

    # Cleanup
    [[ "${cart_debug}" == "true" ]] && echo "Unmounting ${mountpoints}/${basename}."
    [[ -e "${mountpoints}/${basename}" ]] && hdiutil detach "${mountpoints}/${basename}" > /dev/null
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${downloads}/${basename}."
    [[ -e "${downloads}/${basename}" ]] && rm -rf "${downloads}/${basename}" || true
}

install_zip() {
    basename="$(basename "${filename}")"
    mkdir -p "${mountpoints}/${basename}"
    unzip -o -d "${mountpoints}/${basename}" "${filename}"
    install_app "${mountpoints}/${basename}"
    # Cleanup
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${mountpoints}/${basename}."
    [[ -e "${mountpoints}/${basename}" ]] && rm -rf "${mountpoints}/${basename}" > /dev/null
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${downloads}/${basename}."
    [[ -e "${downloads}/${basename}" ]] && rm -rf "${downloads}/${basename}" || true
}

# Function to determine file type
check_file() {
    file="$1"
    file_data="$(file -I "${file}")"
    echo -n "${file_data}" | grep -q 'application/x-bzip2' && file_type="dmg"
    echo -n "${file_data}" | grep -q 'application/zlib' && file_type="dmg"
    echo -n "${file_data}" | grep -q 'application/zip' && file_type="zip"
    echo -n "${file_data}" | grep -q 'application/x-xz' && file_type="xz"

    if [[ -z "${file_type}" ]]
    then
        printf "Unsupported filetype for "${file}".\n Exiting."
        exit 4
    fi
}

# Save app name for use with other subcommands
register_app() {
    app_name="$1"
    mkdir -p "${cart_dir}"

    # Create applist.json if it doesn't exit
    [[ ! -e "${cart_dir}/applist.json" ]] && echo '[]' > "${cart_dir}/applist.json"
    # Remove entry from applist.json if already exists
    sed -i '' -e "\|^${app_name}|d" "${cart_dir}/applist.json"
    # Add app info to applist.json
    cat "${cart_dir}/applist.json" | jq '. += [ { "name": "'${app_name}'", "source": "'${archive_url}'", "hash": "'${filehash}'", "path": "'${app_dest}'"} ]' > "${cart_dir}/applist.json.tmp"
    cp "${cart_dir}/applist.json.tmp" "${cart_dir}/applist.json"
    rm -f "${cart_dir}/applist.json.tmp"
}

domain_regex='(https?|ftp|file)://[-[:alnum:]\+&@#/%?=~_|!:,.;]*[-[:alnum:]\+&@#/%=~_|]'
add() {
    hash="$2"
    add_help() {
        printf "Usage: cart add \"https://github.com/<some-repo>/releases/download/<some-release>/<some-app>.dmg\" \"sha256-hash\"\n" && exit 0
    }
    case "$1" in
        "-h" | "--help")
            add_help
        ;;
    esac

    prep

    archive_url="$1"
    [[ "${cart_debug}" == "true" ]] && echo "Archive URL: ${archive_url}"
    if [[ ! ${archive_url} =~ ${domain_regex} ]]
    then
        # If argument is local file, try to use it
        if [[ -e ${archive_url} ]]
        then
            local_file="true"
        else
            add_help
        fi
    fi

    if grep -q "${archive_url}" "${cart_dir}/applist.json" &>/dev/null
    then
        echo "App ${archive_url} already installed. Exiting."
        exit 0
    fi

    download_file
    check_hash "${hash}"
    check_file "${filename}"
    [[ "${file_type}" == "dmg" ]] && install_dmg
    [[ "${file_type}" == "zip" ]] && install_zip
    [[ "${file_type}" == "xz" ]] && install_dmg
    [[ -n "${app_name}" ]] && register_app "${app_name}"
}

del() {
    app_name="$1"
    del_help() {
        printf "Usage: cart del <app>"
        exit 0
    }

    case "$1" in
        "-h" | "--help")
            del_help
        ;;
    esac

    prep
    if [[ -e "${cart_dir}/applist.json" ]]
    then
        if cat "${cart_dir}/applist.json" | jq -r '.[] | select(.name == "'${app_name}'")' | grep -q "${app_name}"
        then
            app_data="$(cat "${cart_dir}/applist.json" | jq -r '.[] | select(.name=="'${app_name}'")')"
            app_dest="$(echo "${app_data}" | jq -r '.path')"
            if [[ -e "${app_dest}" ]]
            then
                [[ "${cart_debug}" == "true" ]] && echo "Removing ${app_dest}"
                if rm -rf "${app_dest}"
                then
                    [[ "${cart_debug}" == "true" ]] && echo "Successfully removed ${app_name}"
                else
                    echo "Failed to remove ${app_name}"
                fi
            fi
            # Remove app entry from applist.json with jq
            cat "${cart_dir}/applist.json" | jq -r 'del(.[] | select(.name == "'${app_name}'"))' > "${cart_dir}/applist.json.tmp"
            cp "${cart_dir}/applist.json.tmp" "${cart_dir}/applist.json"
            rm -f "${cart_dir}/applist.json.tmp"
        else
            echo "No app named ${app_name} detected. Exiting."
            exit 0
        fi
    else
        echo "No applications installed with cart detected."
    fi
}

list() {
    list_help() {
        printf "Usage: cart list [--all --json]"
        exit 0
    }

    prep

    short_list="true"

    case "$*" in
        "-h" | "--help")
            list_help
        ;;
        "-a" | "--all")
            full_list="true"
            short_list="false"
        ;;
        "-j" | "--json")
            json_list="true"
            short_list="false"
        ;;
    esac

    if [[ -e "${cart_dir}/applist.json" ]]
    then
        echo "Installed applications:"
        [[ "${short_list}" == "true" ]] && cat "${cart_dir}/applist.json" | jq -r '.[].name' && exit 0
        [[ "${full_list}" == "true" ]] && cat "${cart_dir}/applist.json" | jq '.' && exit 0
        [[ "${json_list}" == "true" ]] && cat "${cart_dir}/applist.json" && exit 0
    else
        echo "No applications installed with cart detected."
    fi
}

clean() {
    clean_help() {
        printf "Usage: cart clean [--all]"
    }

    echo "Cleaning up ${cart_dir}"
    if [[ "$*" == *"--all"* ]]
    then
       rm -rf "${cart_dir}"
    else
       printf "Excluding the following files from deletion:\ncart.config\napplist.json\n"
       find "${cart_dir}" | grep -vE "cart.config|applist.json" | xargs rm
    fi
}

