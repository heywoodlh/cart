#!/bin/zsh

set -e

# VERSION awareness
version="0.2.0"

# Hardcode PATH to ensure MacOS-provided executables are exclusively used
# Reminder, BSD tools are quite different from GNU tooling
export PATH="/bin:/usr/bin:/sbin:/usr/sbin"

# Only support MacOS
if ! uname | grep -qE '^Darwin' &>/dev/null
then
    echo "Did not detect MacOS. Exiting."
    exit 1
else
    # Install command-line tools if not installed
    pkgutil --pkg-info com.apple.pkg.CLTools_Executables &>/dev/null || xcode-select --install
fi

# Global variables, can be overridden in cart.config
downloads="/tmp/cart/downloads"
mountpoints="/tmp/cart/mountpoints"
apps_folder="${HOME}/Applications"
cart_dir="${HOME}/Library/Application Support/cart"
jq_force_install="false"
# Repository lists are fetched from this API for `cart repo add github:<owner>/<repo>`
github_api="https://api.github.com"
jq_version="1.8.1"
jq_arm64_hash="a9fe3ea2f86dfc72f6728417521ec9067b343277152b114f4e98d8cb0e263603"
jq_x86_64_hash="e80dbe0d2a2597e3c11c404f03337b981d74b4a8504b70586c354b7697a7c27f"
# grab hashes with:
# jq_version="1.8.1" curl -Ls https://github.com/jqlang/jq/releases/download/jq-$jq_version/jq-macos-arm64 -o /tmp/jq-arm64 && shasum -a 256 /tmp/jq-arm64
# jq_version="1.8.1" curl -Ls https://github.com/jqlang/jq/releases/download/jq-$jq_version/jq-macos-amd64 -o /tmp/jq-amd64 && shasum -a 256 /tmp/jq-amd64

# Other global variables, not managed with config
archive_url=""
file_type=""

# Prep needed for actual package management (add, del)
prep() {
    # Prep phase
    [[ -n "${cart_debug}" ]] || cart_debug="false"

    # Usage if something besides URL is provided
    config_file=""
    source_config() {
        file="$1"
        if [[ -z "${config_file}" ]]
        then
            if [[ -e "${file}" ]]
            then
                [[ "${cart_debug}" == "true" ]] && echo "Config file discovered: ${file}"
                source "${file}"
            fi
        fi
    }

    if [[ -n ${CART_CONFIG} ]]
    then
        source_config "${CART_CONFIG}"
    else
        source_config "./cart.config" \
            || source_config "${HOME}/Library/Application Support/cart/cart.config" \
            || source_config "${HOME}/.config/cart/cart.config"
    fi

    # Use /Applications if root
    if [[ -z "${apps_folder}" ]]
    then
        apps_folder="${HOME}/Applications"
        if [[ $(id -u) == 0 ]]
        then
            [[ "${cart_debug}" == "true" ]] && echo "Running as root, apps will be installed to /Applications"
            apps_folder="/Applications"
        else
           [[ "${cart_debug}" == "true" ]] && echo "Running unprivileged, apps will be installed to ${HOME}/Applications"
           apps_folder="${HOME}/Applications"
        fi
    fi

    # Create directories
    mkdir -p "${mountpoints}" "${downloads}" "${apps_folder}"

    # Repository registry lives alongside the installed application list.
    # Derived here because cart_dir can be overridden by cart.config.
    repositories_file="${cart_dir}/repositories.json"
    repositories_dir="${cart_dir}/repos"
    mkdir -p "${repositories_dir}"

    # For older MacOS versions, install jq
    export PATH="${cart_dir}/bin:${PATH}"
    if ! command -v jq &>/dev/null || [[ "${jq_force_install}" == "true" ]]
    then
        [[ "${cart_debug}" == "true" ]] && echo "Installing jq"
        mkdir -p "${cart_dir}/bin"
        [[ "$(arch)" == "arm64" ]] && jq_arch="arm64" && jq_hash="${jq_arm64_hash}"
        [[ -z "${jq_arch}" ]] && jq_arch="amd64" && jq_hash="${jq_x86_64_hash}"
        jq_url="https://github.com/jqlang/jq/releases/download/jq-${jq_version}/jq-macos-${jq_arch}"
        [[ "${cart_debug}" == "true" ]] && echo "Downloading: ${jq_url}"
        curl -Ls "${jq_url}" -o "${cart_dir}/bin/jq" && chmod +x "${cart_dir}/bin/jq"
        [[ "${jq_hash}" != $(shasum -a 256 "${cart_dir}/bin/jq" | awk '{print $1}') ]] && echo "jq hash mismatch. Exiting." && exit 1
    fi
    command -v jq &>/dev/null || { echo "jq not found. Exiting."; exit 1; }
}

filename=""
local_file="false"
download_file() {
    [[ -e "${archive_url}" ]] && local_file="true"
    if [[ "${local_file}" == "true" ]]
    then
        [[ "${cart_debug}" == "true" ]] && echo "Using local file ${archive_url}"
        filename="${archive_url}"
    else
        # Download filename
        [[ "${cart_debug}" == "true" ]] && echo "Downloading ${archive_url}..."
        rm -rf "${downloads}" && mkdir -p "${downloads}" # clear downloads folder if incomplete downloads exist (i.e. if `cart add` is interrupted)
        filename="$(curl --progress-bar --output-dir "${downloads}" -OJsL "${archive_url}" -w "%{filename_effective}")"
        [[ "${cart_debug}" == "true" ]] && echo "Output file: ${filename}"
    fi
}

filehash=""
check_hash() {
    filehash="$(shasum -a 256 ${filename} | awk '{print $1}')"
    # If hash provided, ensure it matches
    if [[ -n "${hash}" ]]
    then
        if [[ "${hash}" != "${filehash}" ]]
        then
            printf "Incorrect file hash provided.\n${filename} hash: ${filehash}\nExiting." && exit 3
        else
            [[ "${cart_debug}" == "true" ]] && printf "File hash looks good.\n"
        fi
    fi
}

app_name=""
app_dest=""
install_app() {
    app_path="$1"
    # Install the first application bundle found anywhere in the extracted tree.
    appfilepath="$(find "${app_path}" -type d -name "*.app" -prune -print -quit)"
    if [[ -n "${appfilepath}" ]]
    then
        appfile="$(basename "${appfilepath}")"
        [[ "${cart_debug}" == "true" ]] && echo "Copying: ${appfilepath} => ${apps_folder}/${appfile}"
        rsync -a --delete "${appfilepath}" "${apps_folder}"
        app_name="${appfile%.*}"
        app_dest="${apps_folder}/${appfile}"
        [[ "${cart_debug}" == "true" ]] && echo "App name: ${app_name}"
    else
        [[ "${cart_debug}" == "true" ]] && echo "Unable to find .app in ${app_path}."
        false
    fi
}

install_dmg() {
    # Ensure that file is a valid dmg file
    [[ "${cart_debug}" == "true" ]] && echo "Ensuring ${filename} integrity"
    if ! hdiutil verify "${filename}" &> /dev/null
    then
        echo "File ${filename} failed dmg integrity check. Cleaning up and Exiting."
        rm -f "${filename}"
        return 2
    fi

    # Mount dmg if it doesn't exist
    basename="$(basename "${filename}")"
    [[ "${cart_debug}" == "true" ]] && echo "Mounting ${mountpoints}/${basename}."
    rm -rf "${mountpoints}/${basename}"
    mkdir -p "${mountpoints}"
    [[ -e "${mountpoints}/${basename}" ]] || hdiutil attach -mountpoint "${mountpoints}/${basename}" "${filename}" > /dev/null

    install_app "${mountpoints}/${basename}"

    # Cleanup
    [[ "${cart_debug}" == "true" ]] && echo "Unmounting ${mountpoints}/${basename}."
    [[ -e "${mountpoints}/${basename}" ]] && hdiutil detach "${mountpoints}/${basename}" > /dev/null
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${downloads}/${basename}."
    [[ -e "${downloads}/${basename}" ]] && rm -rf "${downloads}/${basename}" || true
    return 0
}

install_zip() {
    archive_name="$(basename "${filename}")"
    archive_dir="${mountpoints}/${archive_name}"
    rm -rf "${archive_dir}" || true
    mkdir -p "${archive_dir}"
    if archive_members_are_safe "zip" \
        && (ulimit -f 8388608; unzip -qo "${filename}" -d "${archive_dir}") \
        && install_app "${archive_dir}"
    then
        install_status=0
    else
        install_status=$?
    fi
    # Cleanup
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${archive_dir}."
    rm -rf "${archive_dir}" || true
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${downloads}/${archive_name}."
    [[ -e "${downloads}/${archive_name}" ]] && rm -rf "${downloads}/${archive_name}" || true
    return "${install_status}"
}

install_tar() {
    archive_name="$(basename "${filename}")"
    archive_dir="${mountpoints}/${archive_name}"
    rm -rf "${archive_dir}" || true
    mkdir -p "${archive_dir}"
    if archive_members_are_safe "tar" \
        && (ulimit -f 8388608; tar -xf "${filename}" -C "${archive_dir}") \
        && install_app "${archive_dir}"
    then
        install_status=0
    else
        install_status=$?
    fi
    # Cleanup
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${archive_dir}."
    rm -rf "${archive_dir}" || true
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${downloads}/${archive_name}."
    [[ -e "${downloads}/${archive_name}" ]] && rm -rf "${downloads}/${archive_name}" || true
    return "${install_status}"
}

install_pkg() {
    archive_name="$(basename "${filename}")"
    package_dir="${mountpoints}/${archive_name}"
    rm -rf "${package_dir}" || true
    mkdir -p "${mountpoints}"
    if (ulimit -f 8388608; pkgutil --expand-full "${filename}" "${package_dir}") \
        && install_app "${package_dir}"
    then
        install_status=0
    else
        install_status=$?
    fi
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${package_dir}."
    rm -rf "${package_dir}" || true
    [[ "${cart_debug}" == "true" ]] && echo "Cleaning up ${downloads}/${archive_name}."
    [[ -e "${downloads}/${archive_name}" ]] && rm -rf "${downloads}/${archive_name}" || true
    return "${install_status}"
}

install_xz_disk_image() {
    archive_name="$(basename "${filename}")"
    disk_image="${downloads}/${archive_name%.xz}"

    if [[ -x /opt/homebrew/bin/xz ]]
    then
        xz_command="/opt/homebrew/bin/xz"
    elif [[ -x /usr/local/bin/xz ]]
    then
        xz_command="/usr/local/bin/xz"
    elif [[ -x /usr/bin/xz ]]
    then
        xz_command="/usr/bin/xz"
    else
        echo "XZ-compressed disk images require an xz executable. Exiting."
        [[ -e "${downloads}/${archive_name}" ]] && rm -f "${filename}" || true
        return 1
    fi

    rm -f "${disk_image}" || true
    if ! (ulimit -f 8388608; "${xz_command}" -dc "${filename}" > "${disk_image}")
    then
        rm -f "${disk_image}" || true
        [[ -e "${downloads}/${archive_name}" ]] && rm -f "${filename}" || true
        echo "Unable to decompress ${filename}. Exiting."
        return 1
    fi

    original_filename="${filename}"
    filename="${disk_image}"
    if install_dmg
    then
        install_status=0
    else
        install_status=$?
    fi
    filename="${original_filename}"
    rm -f "${disk_image}" || true
    [[ -e "${downloads}/${archive_name}" ]] && rm -rf "${downloads}/${archive_name}" || true
    return "${install_status}"
}

archive_members_are_safe() {
    archive_type="$1"
    member=""
    member_count=0
    member_list="$(mktemp "${mountpoints}/.cart-members.XXXXXX")" || return 1

    if [[ "${archive_type}" == "zip" ]]
    then
        if ! unzip -Z1 "${filename}" > "${member_list}"
        then
            rm -f "${member_list}" || true
            echo "Unable to inspect archive members. Exiting." >&2
            return 1
        fi
    elif ! tar -tf "${filename}" > "${member_list}"
    then
        rm -f "${member_list}" || true
        echo "Unable to inspect archive members. Exiting." >&2
        return 1
    fi

    while IFS= read -r member
    do
        member_count=$((member_count + 1))
        if [[ "${member_count}" -gt 100000 ]]
        then
            rm -f "${member_list}" || true
            echo "Archive has too many members. Exiting." >&2
            return 1
        fi

        case "${member}" in
            /* | ../* | */../* | ..)
                rm -f "${member_list}" || true
                echo "Unsafe archive member: ${member}" >&2
                return 1
            ;;
        esac
    done < "${member_list}"

    rm -f "${member_list}" || true
}

# Determine whether the input is a native macOS archive or disk image.
check_file() {
    file="$1"
    if unzip -tqq "${file}" &> /dev/null
    then
        file_type="zip"
    elif xar -tf "${file}" 2> /dev/null | grep -Fxq "PackageInfo"
    then
        file_type="pkg"
    elif tar -tf "${file}" &> /dev/null
    then
        file_type="tar"
    elif hdiutil verify "${file}" &> /dev/null
    then
        file_type="dmg"
    elif file -I "${file}" | grep -q 'application/x-xz'
    then
        file_type="xz"
    else
        printf "Unsupported archive or disk image for ${file}.\nExiting."
        exit 4
    fi
}

# Save app name for use with other subcommands
register_app() {
    app_name="$1"
    mkdir -p "${cart_dir}"

    # Create applist.json if it doesn't exit
    [[ ! -e "${cart_dir}/applist.json" ]] && echo '[]' > "${cart_dir}/applist.json"
    # Remove entry from applist.json if already exists
    sed -i '' -e "\|^${app_name}|d" "${cart_dir}/applist.json"
    # Add app info to applist.json
    cat "${cart_dir}/applist.json" | jq '. += [ { "name": "'${app_name}'", "source": "'${archive_url}'", "hash": "'${filehash}'", "path": "'${app_dest}'"} ]' > "${cart_dir}/applist.json.tmp"
    cp "${cart_dir}/applist.json.tmp" "${cart_dir}/applist.json"
    rm -f "${cart_dir}/applist.json.tmp"
}

domain_regex='(https?|ftp|file)://[-[:alnum:]\+&@#/%?=~_|!:,.;]*[-[:alnum:]\+&@#/%=~_|]'
add() {
    hash="$2"
    add_help() {
        printf "Usage: cart add <url|local-file|app|repository/app> [sha256-hash]\n"
        printf "Applications are resolved from repositories configured with 'cart repo add'.\n"
        exit 0
    }
    case "$1" in
        "-h" | "--help")
            add_help
        ;;
    esac

    [[ -n "$1" ]] || add_help

    prep

    archive_url="$1"
    [[ "${cart_debug}" == "true" ]] && echo "Archive URL: ${archive_url}"
    if [[ ! ${archive_url} =~ ${domain_regex} ]]
    then
        # If argument is local file, try to use it
        if [[ -e ${archive_url} ]]
        then
            local_file="true"
        else
            # Resolve an application name from configured repositories
            if ! resolve_repo_app "${archive_url}"
            then
                exit 5
            fi
            archive_url="${resolved_url}"
            [[ -z "${hash}" ]] && hash="${resolved_hash}"
            [[ "${cart_debug}" == "true" ]] && echo "Archive URL: ${archive_url}"
        fi
    fi

    if grep -q "${archive_url}" "${cart_dir}/applist.json" &>/dev/null
    then
        echo "App ${archive_url} already installed. Exiting."
        exit 0
    fi

    download_file
    check_hash "${hash}"
    check_file "${filename}"
    [[ "${file_type}" == "dmg" ]] && install_dmg
    [[ "${file_type}" == "zip" ]] && install_zip
    [[ "${file_type}" == "pkg" ]] && install_pkg
    [[ "${file_type}" == "tar" ]] && install_tar
    [[ "${file_type}" == "xz" ]] && install_xz_disk_image
    [[ -n "${app_name}" ]] && register_app "${app_name}"
}

del() {
    app_name="$1"
    del_help() {
        printf "Usage: cart del <app>"
        exit 0
    }

    case "$1" in
        "-h" | "--help")
            del_help
        ;;
    esac

    prep
    if [[ -e "${cart_dir}/applist.json" ]]
    then
        if cat "${cart_dir}/applist.json" | jq -r '.[] | select(.name == "'${app_name}'")' | grep -q "${app_name}"
        then
            app_data="$(cat "${cart_dir}/applist.json" | jq -r '.[] | select(.name=="'${app_name}'")')"
            app_dest="$(echo "${app_data}" | jq -r '.path')"
            if [[ -e "${app_dest}" ]]
            then
                [[ "${cart_debug}" == "true" ]] && echo "Removing ${app_dest}"
                if rm -rf "${app_dest}"
                then
                    [[ "${cart_debug}" == "true" ]] && echo "Successfully removed ${app_name}"
                else
                    echo "Failed to remove ${app_name}"
                fi
            fi
            # Remove app entry from applist.json with jq
            cat "${cart_dir}/applist.json" | jq -r 'del(.[] | select(.name == "'${app_name}'"))' > "${cart_dir}/applist.json.tmp"
            cp "${cart_dir}/applist.json.tmp" "${cart_dir}/applist.json"
            rm -f "${cart_dir}/applist.json.tmp"
        else
            echo "No app named ${app_name} detected. Exiting."
            exit 0
        fi
    else
        echo "No applications installed with cart detected."
    fi
}

list() {
    list_help() {
        printf "Usage: cart list [--all --json]"
        exit 0
    }

    prep

    short_list="true"

    case "$*" in
        "-h" | "--help")
            list_help
        ;;
        "-a" | "--all")
            full_list="true"
            short_list="false"
        ;;
        "-j" | "--json")
            json_list="true"
            short_list="false"
        ;;
    esac

    if [[ -e "${cart_dir}/applist.json" ]]
    then
        echo "Installed applications:"
        [[ "${short_list}" == "true" ]] && cat "${cart_dir}/applist.json" | jq -r '.[].name' && exit 0
        [[ "${full_list}" == "true" ]] && cat "${cart_dir}/applist.json" | jq '.' && exit 0
        [[ "${json_list}" == "true" ]] && cat "${cart_dir}/applist.json" && exit 0
    else
        echo "No applications installed with cart detected."
    fi
}

clean() {
    clean_help() {
        printf "Usage: cart clean [--all]"
    }

    echo "Cleaning up ${cart_dir}"
    if [[ "$*" == *"--all"* ]]
    then
       rm -rf "${cart_dir}"
    else
       printf "Excluding the following files from deletion:\ncart.config\napplist.json\nrepositories.json\nrepos/\n"
       for entry in "${cart_dir}"/*(DN)
       do
           case "${entry##*/}" in
               cart.config | applist.json | repositories.json | repos)
                   continue
               ;;
           esac
           rm -rf "${entry}"
       done
    fi
}

# Repository lists
#
# A repository is a JSON document listing installable applications:
#
#   {
#     "name": "example",
#     "apps": [
#       { "name": "UTM", "url": "https://.../UTM.dmg", "hash": "<sha256>" }
#     ]
#   }
#
# Configured repositories are recorded in ${cart_dir}/repositories.json and a
# verified copy of each list is kept in ${cart_dir}/repos/<name>.json, so
# `cart add <app>` works offline against the last verified copy.
json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

repo_help() {
    cat <<'EOF'
Usage:
  cart repo add <url> [--name <name>] [--key <public-key>] [--hash <sha256>]
  cart repo add github:<owner>/<repo>[@<tag>] [--name <name>]
  cart repo del <name>
  cart repo update [<name>] [--key <public-key>] [--hash <sha256>]
  cart repo list
EOF
}

repo_stored() {
    printf '%s/%s.json' "${repositories_dir}" "$1"
}

repo_registry() {
    [[ -e "${repositories_file}" ]] || return 0
    # `key` is the only optional field and stays last: shell `read` collapses
    # runs of whitespace, so an empty field in the middle would shift values.
    jq -r '.[] | [.name, .type, .url, .hash, .key] | @tsv' "${repositories_file}"
}

repo_registry_has() {
    [[ -e "${repositories_file}" ]] || return 1
    repo_registry | awk -F '\t' -v name="$1" '$1 == name { found = 1 } END { exit !found }'
}

repo_registry_add() {
    local name="$1" type="$2" url="$3" key="$4" hash="$5"
    local entry
    entry="{\"name\":\"$(json_escape "${name}")\",\"type\":\"$(json_escape "${type}")\",\"url\":\"$(json_escape "${url}")\",\"key\":\"$(json_escape "${key}")\",\"hash\":\"$(json_escape "${hash}")\"}"
    jq ". += [ ${entry} ]" "${repositories_file}" > "${repositories_file}.tmp"
    mv "${repositories_file}.tmp" "${repositories_file}"
}

repo_registry_remove() {
    local name="$1"
    jq "del(.[] | select(.name == \"${name}\"))" "${repositories_file}" > "${repositories_file}.tmp"
    mv "${repositories_file}.tmp" "${repositories_file}"
}

repo_validate_name() {
    if [[ ! "$1" =~ ^[A-Za-z0-9._-]+$ ]]
    then
        echo "Invalid repository name: $1" >&2
        return 1
    fi
}

repo_name_from_url() {
    local base="${1##*/}"
    base="${base%%\?*}"
    base="${base%.json}"
    printf '%s' "${base}"
}

repo_fetch() {
    local url="$1" dest="$2"
    if [[ "${url}" == file://* ]]
    then
        [[ -e "${url#file://}" ]] || return 1
        cp "${url#file://}" "${dest}"
    else
        curl -fsSL "${url}" -o "${dest}"
    fi
}

repo_sha256() {
    shasum -a 256 "$1" | awk '{print $1}'
}

repo_verify_signature() {
    local key="$1" signature="$2" file="$3"
    if [[ ! -e "${key}" ]]
    then
        echo "Signature key not found: ${key}" >&2
        return 1
    fi
    if [[ ! -e "${signature}" ]]
    then
        echo "Signature file not found: ${signature}" >&2
        return 1
    fi
    openssl dgst -sha256 -verify "${key}" -signature "${signature}" "${file}" &> /dev/null
}

repo_validate_file() {
    local file="$1" name="" url="" hash=""
    if ! jq -e '.apps' "${file}" &> /dev/null
    then
        echo "Repository ${file} has no apps list." >&2
        return 1
    fi
    local found="false"
    while IFS=$'\t' read -r name url hash
    do
        found="true"
        if [[ -z "${name}" || -z "${url}" ]]
        then
            echo "Repository ${file} contains an app without a name or url." >&2
            return 1
        fi
        if [[ ! "${hash}" =~ ^[0-9a-fA-F]{64}$ ]]
        then
            echo "Repository ${file} app ${name} must provide a sha256 hash." >&2
            return 1
        fi
    done < <(jq -r '.apps[] | [.name, .url, .hash] | @tsv' "${file}")
    if [[ "${found}" != "true" ]]
    then
        echo "Repository ${file} contains no apps." >&2
        return 1
    fi
}

# Build a repository list from a GitHub release. Assets without a published
# sha256 digest are skipped: cart installs from the hash recorded in the list.
repo_fetch_github() {
    local spec="$1" name="$2" dest="$3" tmp_dir="$4"
    local tag="" owner="" repo="" api_url="" release_json="" tag_name=""
    local asset_name="" asset_url="" asset_digest="" asset_hash="" ext=""
    local app_name="" apps_json="" app_count=0 line=""
    local -A seen_apps
    seen_apps=()

    spec="${spec#github:}"
    if [[ "${spec}" == *"@"* ]]
    then
        tag="${spec##*@}"
        spec="${spec%@*}"
    fi
    owner="${spec%%/*}"
    repo="${spec#*/}"
    if [[ -z "${owner}" || -z "${repo}" || "${spec}" != */* ]]
    then
        echo "Invalid GitHub repository reference: github:${spec}" >&2
        return 2
    fi

    if [[ -n "${tag}" ]]
    then
        api_url="${github_api}/repos/${owner}/${repo}/releases/tags/${tag}"
    else
        api_url="${github_api}/repos/${owner}/${repo}/releases/latest"
    fi

    release_json="${tmp_dir}/release.json"
    if ! repo_fetch "${api_url}" "${release_json}"
    then
        echo "Unable to fetch release metadata from ${api_url}." >&2
        return 1
    fi

    tag_name="$(jq -r '.tag_name' "${release_json}")"
    [[ "${tag_name}" == "null" ]] && tag_name=""

    while IFS=$'\t' read -r asset_name asset_url asset_digest
    do
        [[ -n "${asset_name}" ]] || continue
        case "${asset_name}" in
            *.tar.gz) ext=".tar.gz" ;;
            *.tar.bz2) ext=".tar.bz2" ;;
            *.tar.xz) ext=".tar.xz" ;;
            *.dmg) ext=".dmg" ;;
            *.zip) ext=".zip" ;;
            *.pkg) ext=".pkg" ;;
            *.tar) ext=".tar" ;;
            *.xz) ext=".xz" ;;
            *) continue ;;
        esac
        asset_hash="${asset_digest#sha256:}"
        if [[ ! "${asset_hash}" =~ ^[0-9a-fA-F]{64}$ ]]
        then
            [[ "${cart_debug}" == "true" ]] && echo "Skipping ${asset_name}: release publishes no sha256 digest."
            continue
        fi
        app_name="${asset_name%${ext}}"
        # Releases often ship the same app in several formats; keep the first.
        if (( ${+seen_apps[${app_name}]} ))
        then
            [[ "${cart_debug}" == "true" ]] && echo "Skipping ${asset_name}: ${app_name} is already listed."
            continue
        fi
        seen_apps[${app_name}]=1
        [[ -n "${apps_json}" ]] && apps_json+=","
        apps_json+="{\"name\":\"$(json_escape "${app_name}")\",\"url\":\"$(json_escape "${asset_url}")\",\"hash\":\"${asset_hash}\"}"
        app_count=$((app_count + 1))
    done < <(jq -r '.assets[] | [.name, .browser_download_url, .digest] | @tsv' "${release_json}")

    if [[ "${app_count}" == "0" ]]
    then
        echo "GitHub release ${owner}/${repo}${tag:+ at ${tag}} publishes no supported assets with sha256 digests." >&2
        return 1
    fi

    local source_url="github:${owner}/${repo}"
    [[ -n "${tag}" ]] && source_url+="@${tag}"
    line="{\"name\":\"$(json_escape "${name}")\",\"url\":\"$(json_escape "${source_url}")\",\"tag\":\"$(json_escape "${tag_name}")\",\"apps\":[${apps_json}]}"
    printf '%s\n' "${line}" > "${dest}"
    [[ "${cart_debug}" == "true" ]] && echo "Generated repository ${name} from ${source_url} with ${app_count} app(s)."
    return 0
}

repo_add() {
    local url="" name="" key="" expected_hash=""
    local tmp_dir="" staging="" actual_hash=""

    while [[ $# -gt 0 ]]
    do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --name=*) name="${1#--name=}"; shift ;;
            --key) key="$2"; shift 2 ;;
            --key=*) key="${1#--key=}"; shift ;;
            --hash) expected_hash="$2"; shift 2 ;;
            --hash=*) expected_hash="${1#--hash=}"; shift ;;
            -h | --help) repo_help; exit 0 ;;
            -*) echo "Unknown option for repo add: $1" >&2; exit 2 ;;
            *) url="$1"; shift ;;
        esac
    done

    if [[ -z "${url}" ]]
    then
        repo_help
        exit 2
    fi

    prep
    [[ -e "${repositories_file}" ]] || echo '[]' > "${repositories_file}"
    tmp_dir="$(mktemp -d "${mountpoints}/.cart-repo.XXXXXX")"
    staging="${tmp_dir}/repo.json"

    if [[ "${url}" == github:* ]]
    then
        if [[ -z "${name}" ]]
        then
            name="${url#github:}"
            name="${name##*/}"
            name="${name%%@*}"
        fi
        repo_validate_name "${name}" || { rm -rf "${tmp_dir}"; exit 2; }
        if repo_registry_has "${name}"
        then
            echo "Repository ${name} is already configured. Use 'cart repo update' to refresh it." >&2
            rm -rf "${tmp_dir}"
            exit 1
        fi
        if ! repo_fetch_github "${url}" "${name}" "${staging}" "${tmp_dir}"
        then
            rm -rf "${tmp_dir}"
            exit 1
        fi
        repo_validate_file "${staging}" || { rm -rf "${tmp_dir}"; exit 1; }
        cp "${staging}" "$(repo_stored "${name}")"
        repo_registry_add "${name}" "github" "${url}" "" "$(repo_sha256 "$(repo_stored "${name}")")"
        echo "Added repository ${name}"
        rm -rf "${tmp_dir}"
        exit 0
    fi

    if ! repo_fetch "${url}" "${staging}"
    then
        echo "Unable to download repository ${url}." >&2
        rm -rf "${tmp_dir}"
        exit 1
    fi

    actual_hash="$(repo_sha256 "${staging}")"
    if [[ -n "${key}" ]]
    then
        if ! repo_fetch "${url}.sig" "${tmp_dir}/repo.json.sig"
        then
            echo "Unable to download signature ${url}.sig." >&2
            rm -rf "${tmp_dir}"
            exit 1
        fi
        if ! repo_verify_signature "${key}" "${tmp_dir}/repo.json.sig" "${staging}"
        then
            echo "Signature verification failed for ${url}. Refusing to add repository (possible MITM)." >&2
            rm -rf "${tmp_dir}"
            exit 1
        fi
    elif [[ -n "${expected_hash}" && "${expected_hash}" != "${actual_hash}" ]]
    then
        echo "Repository hash mismatch for ${url}." >&2
        echo "Expected: ${expected_hash}" >&2
        echo "Actual:   ${actual_hash}" >&2
        rm -rf "${tmp_dir}"
        exit 1
    fi

    repo_validate_file "${staging}" || { rm -rf "${tmp_dir}"; exit 1; }

    if [[ -z "${name}" ]]
    then
        name="$(jq -r '.name' "${staging}")"
        if [[ -z "${name}" || "${name}" == "null" ]]
        then
            name="$(repo_name_from_url "${url}")"
        fi
    fi
    repo_validate_name "${name}" || { rm -rf "${tmp_dir}"; exit 2; }

    if repo_registry_has "${name}"
    then
        echo "Repository ${name} is already configured. Use 'cart repo update' to refresh it." >&2
        rm -rf "${tmp_dir}"
        exit 1
    fi

    cp "${staging}" "$(repo_stored "${name}")"
    repo_registry_add "${name}" "remote" "${url}" "${key}" "${actual_hash}"
    echo "Added repository ${name}"
    if [[ -z "${key}" ]]
    then
        printf 'Repository content hash: %s\n' "${actual_hash}"
        printf 'Pin this hash (--hash) or a signing key (--key) to detect tampering on update.\n'
    fi
    rm -rf "${tmp_dir}"
}

repo_del() {
    local name="$1"

    if [[ -z "${name}" ]]
    then
        repo_help
        exit 2
    fi

    prep
    if ! repo_registry_has "${name}"
    then
        echo "No repository named ${name} configured." >&2
        exit 1
    fi

    rm -f "$(repo_stored "${name}")"
    repo_registry_remove "${name}"
    echo "Removed repository ${name}"
}

repo_update_one() {
    local name="$1" type="$2" url="$3" hash="$4" key="$5"
    local expected_hash="$6" new_key="$7"
    local tmp_dir="" staging="" actual_hash=""

    [[ -n "${new_key}" ]] && key="${new_key}"

    tmp_dir="$(mktemp -d "${mountpoints}/.cart-repo.XXXXXX")"
    staging="${tmp_dir}/repo.json"

    if [[ "${type}" == "github" ]]
    then
        if ! repo_fetch_github "${url}" "${name}" "${staging}" "${tmp_dir}"
        then
            rm -rf "${tmp_dir}"
            return 1
        fi
    else
        if ! repo_fetch "${url}" "${staging}"
        then
            echo "Unable to download repository ${name} from ${url}." >&2
            rm -rf "${tmp_dir}"
            return 1
        fi
        actual_hash="$(repo_sha256 "${staging}")"
        if [[ -n "${key}" ]]
        then
            if ! repo_fetch "${url}.sig" "${tmp_dir}/repo.json.sig"
            then
                echo "Unable to download signature ${url}.sig for ${name}." >&2
                rm -rf "${tmp_dir}"
                return 1
            fi
            if ! repo_verify_signature "${key}" "${tmp_dir}/repo.json.sig" "${staging}"
            then
                echo "Signature verification failed for ${name}. Refusing to update (possible MITM)." >&2
                rm -rf "${tmp_dir}"
                return 1
            fi
        else
            if [[ -n "${expected_hash}" ]]
            then
                hash="${expected_hash}"
            fi
            if [[ "${hash}" != "${actual_hash}" ]]
            then
                if [[ -n "${expected_hash}" ]]
                then
                    echo "Repository hash mismatch for ${name}." >&2
                    echo "Expected: ${expected_hash}" >&2
                    echo "Actual:   ${actual_hash}" >&2
                else
                    echo "Repository ${name} content changed and no signing key is pinned. Refusing to update (possible MITM)." >&2
                    echo "Re-run with --hash ${actual_hash} to accept the new content, or configure --key." >&2
                fi
                rm -rf "${tmp_dir}"
                return 1
            fi
        fi
    fi

    if ! repo_validate_file "${staging}"
    then
        rm -rf "${tmp_dir}"
        return 1
    fi

    mv "${staging}" "$(repo_stored "${name}")"
    actual_hash="$(repo_sha256 "$(repo_stored "${name}")")"
    repo_registry_remove "${name}"
    repo_registry_add "${name}" "${type}" "${url}" "${key}" "${actual_hash}"
    echo "Updated repository ${name}"
    rm -rf "${tmp_dir}"
}

repo_update() {
    local name_filter="" expected_hash="" new_key="" registry="" failed=0
    local rname="" rtype="" rurl="" rhash="" rkey=""

    while [[ $# -gt 0 ]]
    do
        case "$1" in
            --key) new_key="$2"; shift 2 ;;
            --key=*) new_key="${1#--key=}"; shift ;;
            --hash) expected_hash="$2"; shift 2 ;;
            --hash=*) expected_hash="${1#--hash=}"; shift ;;
            -h | --help) repo_help; exit 0 ;;
            -*) echo "Unknown option for repo update: $1" >&2; exit 2 ;;
            *) name_filter="$1"; shift ;;
        esac
    done

    prep
    [[ -e "${repositories_file}" ]] || echo '[]' > "${repositories_file}"

    if [[ -n "${name_filter}" ]] && ! repo_registry_has "${name_filter}"
    then
        echo "No repository named ${name_filter} configured." >&2
        exit 1
    fi

    registry="$(repo_registry)"
    if [[ -z "${registry}" ]]
    then
        echo "No repositories configured."
        exit 0
    fi

    while IFS=$'\t' read -r rname rtype rurl rhash rkey
    do
        [[ -n "${rname}" ]] || continue
        if [[ -n "${name_filter}" && "${rname}" != "${name_filter}" ]]
        then
            continue
        fi
        if ! repo_update_one "${rname}" "${rtype}" "${rurl}" "${rhash}" "${rkey}" "${expected_hash}" "${new_key}"
        then
            failed=1
        fi
    done <<< "${registry}"

    exit "${failed}"
}

repo_list() {
    prep
    [[ -e "${repositories_file}" ]] || echo '[]' > "${repositories_file}"
    printf 'Configured repositories:\n'
    repo_registry | awk -F '\t' 'NF { printf "%s\t%s\t%s\n", $1, $2, $3 }'
}

# Resolve `cart add <app>` or `cart add <repo>/<app>` from configured repositories.
resolve_repo_app() {
    local query="$1"
    local repo_filter="" app_query="" registry=""
    local rname="" rtype="" rurl="" rhash="" rkey=""
    local aname="" aurl="" ahash="" repo_file=""
    local -a matches
    matches=()
    resolved_url=""
    resolved_hash=""

    repo_filter=""
    app_query="${query}"
    if [[ "${query}" == */* ]]
    then
        repo_filter="${query%%/*}"
        app_query="${query#*/}"
    fi

    registry="$(repo_registry)"
    if [[ -n "${repo_filter}" ]] && ! repo_registry_has "${repo_filter}"
    then
        echo "No repository named ${repo_filter} configured." >&2
        return 1
    fi

    while IFS=$'\t' read -r rname rtype rurl rhash rkey
    do
        [[ -n "${rname}" ]] || continue
        if [[ -n "${repo_filter}" && "${rname}" != "${repo_filter}" ]]
        then
            continue
        fi
        repo_file="$(repo_stored "${rname}")"
        [[ -e "${repo_file}" ]] || continue
        while IFS=$'\t' read -r aname aurl ahash
        do
            [[ "${aname}" == "${app_query}" ]] || continue
            matches+=("${rname}/${aname}")
            resolved_url="${aurl}"
            resolved_hash="${ahash}"
        done < <(jq -r '.apps[] | [.name, .url, .hash] | @tsv' "${repo_file}")
    done <<< "${registry}"

    if [[ "${#matches[@]}" == "0" ]]
    then
        echo "No application named ${query} found in configured repositories." >&2
        return 1
    fi

    if [[ "${#matches[@]}" -gt "1" ]]
    then
        echo "Application ${app_query} is provided by multiple repositories:" >&2
        printf '  %s\n' "${matches[@]}" >&2
        echo "Use 'cart add <repository>/<app>' to choose one." >&2
        return 1
    fi

    if [[ "${cart_debug}" == "true" ]]
    then
        echo "Resolved ${matches[1]} to ${resolved_url}"
    fi
}

repo() {
    local subcommand="$1"
    shift

    case "${subcommand}" in
        add)
            repo_add "$@"
        ;;
        del | remove)
            repo_del "$@"
        ;;
        update)
            repo_update "$@"
        ;;
        list)
            repo_list "$@"
        ;;
        -h | --help | "")
            repo_help
        ;;
        *)
            echo "Unknown repo subcommand: ${subcommand}" >&2
            repo_help
            exit 2
        ;;
    esac
}


subcommand=$1
case $subcommand in
    "add")
        shift
        add $@
        ;;
    "del")
        shift
        del $@
        ;;
    "list")
        shift
        list $@
        ;;
    "clean")
        shift
        clean $@
        ;;
    "repo")
        shift
        repo "$@"
        ;;
    *)
        printf "Usage: cart [ add, del, list, clean, repo ]\nVersion: ${version}"
        ;;
esac
